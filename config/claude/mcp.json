{
  "mcpServers": {
    "linear": {
      "type": "http",
      "url": "https://mcp.linear.app/mcp"
    },
    "github": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"]
    },
    "figma": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "figma-developer-mcp", "--stdio"],
      "env": {
        "FIGMA_API_KEY": "${FIGMA_TOKEN}",
        "FRAMELINK_TELEMETRY": "off"
      }
    },
    "figma-desktop": {
      "type": "http",
      "url": "http://127.0.0.1:3845/mcp"
    },
    "envato": {
      "type": "http",
      "url": "https://mcp.envato.com/mcp"
    },
    "coolify": {
      "type": "http",
      "url": "https://coolify.imowiz.com.br/mcp",
      "headers": {
        "Authorization": "Bearer ${COOLIFY_TOKEN}"
      }
    }
  }
}
