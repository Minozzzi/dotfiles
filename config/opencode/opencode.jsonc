{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "./instructions/global-skills.md",
    "./instructions/clickup-tasks.md",
    "./instructions/figma-code-connect/SKILL.md",
    "./instructions/figma-create-new-file/SKILL.md",
    "./instructions/figma-generate-design/SKILL.md",
    "./instructions/figma-generate-diagram/SKILL.md",
    "./instructions/figma-generate-library/SKILL.md",
    "./instructions/figma-implement-motion/SKILL.md",
    "./instructions/figma-swiftui/SKILL.md",
    "./instructions/figma-use/SKILL.md",
    "./instructions/figma-use-figjam/SKILL.md",
    "./instructions/figma-use-motion/SKILL.md",
    "./instructions/figma-use-slides/SKILL.md",
    "./instructions/generate-project-plan/SKILL.md",
    "./instructions/antigravity_guide/SKILL.md",
    "./instructions/azure-kubernetes/SKILL.md",
    "./instructions/banner-design/SKILL.md",
    "./instructions/brand/SKILL.md",
    "./instructions/caveman-commit/SKILL.md",
    "./instructions/design/SKILL.md",
    "./instructions/design-system/SKILL.md",
    "./instructions/design-taste-frontend/SKILL.md",
    "./instructions/docx/SKILL.md",
    "./instructions/emil-design-eng/SKILL.md",
    "./instructions/executing-plans/SKILL.md",
    "./instructions/finishing-a-development-branch/SKILL.md",
    "./instructions/frontend-design/SKILL.md",
    "./instructions/github-actions-docs/SKILL.md",
    "./instructions/graphify/SKILL.md",
    "./instructions/handoff/SKILL.md",
    "./instructions/high-end-visual-design/SKILL.md",
    "./instructions/mestre-tcc/SKILL.md",
    "./instructions/minimalist-ui/SKILL.md",
    "./instructions/pdf/SKILL.md",
    "./instructions/pptx/SKILL.md",
    "./instructions/receiving-code-review/SKILL.md",
    "./instructions/requesting-code-review/SKILL.md",
    "./instructions/shadcn/SKILL.md",
    "./instructions/slides/SKILL.md",
    "./instructions/supabase/SKILL.md",
    "./instructions/systematic-debugging/SKILL.md",
    "./instructions/tdd/SKILL.md",
    "./instructions/test-driven-development/SKILL.md",
    "./instructions/ui-styling/SKILL.md",
    "./instructions/ui-ux-pro-max/SKILL.md",
    "./instructions/using-git-worktrees/SKILL.md",
    "./instructions/using-superpowers/SKILL.md",
    "./instructions/vercel-composition-patterns/SKILL.md",
    "./instructions/vercel-react-best-practices/SKILL.md",
    "./instructions/verification-before-completion/SKILL.md",
    "./instructions/web-design-guidelines/SKILL.md",
    "./instructions/webapp-testing/SKILL.md",
    "./instructions/writing-plans/SKILL.md",
    "./instructions/xlsx/SKILL.md",
    "./instructions/a11y-debugging/SKILL.md",
    "./instructions/chrome-devtools/SKILL.md",
    "./instructions/chrome-devtools-cli/SKILL.md",
    "./instructions/debug-optimize-lcp/SKILL.md",
    "./instructions/memory-leak-debugging/SKILL.md",
    "./instructions/troubleshooting/SKILL.md",
    "./instructions/code-review/SKILL.md",
    "./instructions/code-review-commons/SKILL.md",
    "./instructions/pr-code-review/SKILL.md",
    "./instructions/brainstorming/SKILL.md",
    "./instructions/dispatching-parallel-agents/SKILL.md",
    "./instructions/subagent-driven-development/SKILL.md",
    "./instructions/writing-skills/SKILL.md",
  ],
  "mcp": {
    "brave": {
      "type": "local",
      "enabled": true,
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-brave-search"],
      "env": {
        "BRAVE_API_KEY": "${BRAVE_API_KEY}",
      },
    },
    "clickup": {
      "type": "local",
      "enabled": true,
      "command": "npx",
      "args": ["-y", "clickup-mcp"],
      "env": {
        "CLICKUP_API_TOKEN": "",
        "CLICKUP_API_KEY": "",
        "CLICKUP_TOKEN": "",
      },
    },
    "gitlab": {
      "type": "local",
      "enabled": true,
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://gitlab.com/api/v4/mcp"],
      "env": {
        "GITLAB_TOKEN": "",
        "GITLAB_PERSONAL_ACCESS_TOKEN": "",
      },
    },
    "figma-desktop": {
      "type": "remote",
      "url": "http://127.0.0.1:3845/mcp",
      "enabled": true,
    },
    "chrome-devtools": {
      "type": "local",
      "enabled": true,
      "command": "npx",
      "args": ["-y", "@anthropic/chrome-devtools-mcp"],
    },
    "datadog": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.datadoghq.com/v1/mcp",
      "env": {
        "DD_API_KEY": "${DD_API_KEY}",
        "DD_APP_KEY": "${DD_APP_KEY}",
      },
    },
    "memory": {
      "type": "local",
      "enabled": true,
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"],
    },
    "postman": {
      "type": "local",
      "enabled": true,
      "command": "npx",
      "args": ["-y", "postman-mcp-server"],
      "env": {
        "POSTMAN_API_KEY": "",
        "NODE_TLS_REJECT_UNAUTHORIZED": "0",
      },
    },
  },
}
