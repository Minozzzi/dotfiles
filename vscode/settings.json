  // Redhat
  "redhat.telemetry.enabled": true,
  // Json
  "json.maxItemsComputed": 0,
  "java.jdt.ls.vmargs": "-XX:+UseParallelGC -XX:GCTimeRatio=4 -XX:AdaptiveSizePolicyWeight=90 -Dsun.zip.disableMemoryMapping=true -Xmx1G -Xms100m -javaagent:\"/home/minozzzi/.vscode/extensions/gabrielbb.vscode-lombok-1.0.1/server/lombok.jar\"",
  "java.jdt.ls.java.home": "/usr/lib/jvm/jdk-17",
  "boot-java.rewrite.reconcile": true,
  // React Native
  "react-native-tools.showUserTips": false,
  // Python notebooks
  "notebook.lineNumbers": "on",
  // GitLens
  "gitlens.advanced.messages": {
    "suppressCommitHasNoPreviousCommitWarning": true,
  },
  "gitlens.graph.layout": "editor",
  // Console Ninja
  "console-ninja.featureSet": "Community",
  "workbench.editor.empty.hint": "hidden",
  "security.promptForLocalFileProtocolHandling": false,
  // Prisma
  "prisma.showPrismaDataPlatformNotification": false,
  "[jade]": {
    "editor.defaultFormatter": "ducfilan.pug-formatter",
  },
  // Cucumber
  "cucumberautocomplete.steps": ["**/*.steps.js"],
  "cucumberautocomplete.syncfeatures": "**/*.feature",
  "editor.accessibilitySupport": "off",
  // Tailwind
  "tailwindCSS.experimental.classRegex": [
    ["tv\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"],
    "class:\\s*?[\"'`]([^\"'`]*).*?,",
  ],
  "workbench.editorAssociations": {
    "*.copilotmd": "vscode.markdown.preview.editor",
    "{git,gitlens}:/**/*.{md,csv,svg}": "default",
    "*.pdf": "latex-workshop-pdf-hook",
  },
  "workbench.editor.enablePreview": false,
  "gitlens.views.scm.grouped.views": {
    "commits": false,
    "branches": false,
    "remotes": false,
    "stashes": false,
    "tags": false,
    "worktrees": false,
    "contributors": false,
    "fileHistory": false,
    "repositories": false,
    "searchAndCompare": false,
    "launchpad": false,
  },
  "terminal.integrated.env.osx": {},
  "gitlens.views.commits.showStashes": true,
  "sonarlint.connectedMode.connections.sonarqube": [],
  "github.copilot.nextEditSuggestions.enabled": true,
  "git.blame.editorDecoration.enabled": false,
  "sonarlint.focusOnNewCode": false,
  "terminal.integrated.enableImages": true,
  "workbench.activityBar.location": "top",
  "workbench.sideBar.location": "left",
  "amazonQ.suppressPrompts": {
    "amazonQChatDisclaimer": true,
    "createCredentialsProfile": true,
    "codeWhispererNewWelcomeMessage": true,
    "codeWhispererConnectionExpired": true,
    "amazonQWelcomePage": true,
    "amazonQSessionConfigurationMessage": true,
    "minIdeVersion": true,
    "ssoCacheError": true,
    "amazonQLspManifestMessage": false,
    "amazonQWorkspaceLspManifestMessage": true,
    "amazonQChatPairProgramming": true,
    "amazonQSelectDeveloperProfile": true,
  },
  "github.copilot.selectedCompletionModel": "",
  "docker.extension.enableComposeLanguageServer": false,
  "sonarlint.automaticAnalysis": true,
  "[github-actions-workflow]": {
    "editor.defaultFormatter": "redhat.vscode-yaml",
  },
  "gitlens.ai.model": "vscode",
  "gitlens.ai.vscode.model": "copilot:gpt-4.1",
  "gitlens.views.launchpad.files.layout": "tree",
  "chat.tools.terminal.autoApprove": {
    "pnpm": true,
    "pkill": true,
    "mkdir": true,
  },
  "chat.checkpoints.showFileChanges": true,
  "chat.renderRelatedFiles": true,
  "chat.restoreLastPanelSession": true,
  "chat.mcp.gallery.enabled": true,
  "github.copilot.enable": {
    "*": true,
    "plaintext": true,
    "markdown": false,
    "scminput": false,
  },
  "window.confirmSaveUntitledWorkspace": false,
