{
  "workbench.editor.labelFormat": "short",
  "workbench.editor.enablePreviewFromQuickOpen": false,
  "workbench.startupEditor": "none",
  "workbench.preferredDarkColorTheme": "Catppuccin Frappé",
  "workbench.preferredLightColorTheme": "Catppuccin Latte",
  "workbench.iconTheme": "material-icon-theme",
  "window.autoDetectColorScheme": true,
  "window.nativeTabs": true,
  // Terminal settings
  "terminal.integrated.fontFamily": "'FiraCode Nerd Font'",
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.fontLigatures.enabled": true,
  "terminal.integrated.minimumContrastRatio": 1,
  "terminal.integrated.macOptionIsMeta": true,
  "terminal.integrated.defaultProfile.linux": "zsh",
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  "terminal.integrated.env.linux": {},
  // Editor settings
  "editor.fontSize": 14,
  "editor.lineHeight": 1.6,
  "catppuccin.accentColor": "mauve",
  "catppuccin.italicKeywords": true,
  "catppuccin.italicComments": true,
  "catppuccin.bracketMode": "rainbow",
  "editor.minimap.enabled": false,
  "editor.wordWrap": "on",
  "editor.rename.enablePreview": false,
  "editor.suggestSelection": "first",
  "editor.fontFamily": "'FiraCode Nerd Font', 'Fira Code', Menlo, monospace",
  "editor.fontWeight": "500",
  "editor.fontLigatures": true,
  "editor.rulers": [80, 120, 160],
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairsHorizontal": true,
  "editor.guides.bracketPairs": "active",
  "editor.stickyScroll.enabled": true,
  "editor.tabSize": 2,
  "editor.inlineSuggest.enabled": true,
  "editor.inlayHints.enabled": "on",
  "editor.detectIndentation": false,
  "editor.codeActionsOnSave": {
    "source.fixAll": "always",
    "source.fixAll.eslint": "always",
    "source.addMissingImports": "always",
    "source.removeUnusedImports": "always",
  },
  "editor.defaultFormatter": "dbaeumer.vscode-eslint",
  "editor.formatOnSave": true,
  "[prisma]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "Prisma.prisma",
  },
  // "[java]": {
  //   "editor.formatOnSave": true,
  //   "editor.defaultFormatter": "redhat.java",
  // },
  // "[typescriptreact]": {
  //   "editor.defaultFormatter": "esbenp.prettier-vscode"
  // },
  // "[typescript]": {
  //   "editor.defaultFormatter": "esbenp.prettier-vscode"
  // },
  "[shellscript]": {
    "editor.defaultFormatter": "foxundermoon.shell-format",
  },
  "[dotenv]": {
    "editor.defaultFormatter": "foxundermoon.shell-format",
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[ignore]": {
    "editor.defaultFormatter": "foxundermoon.shell-format",
  },
  "[markdown]": {
    "editor.defaultFormatter": "DavidAnson.vscode-markdownlint",
  },
  "[latex]": {
    "editor.defaultFormatter": "James-Yu.latex-workshop",
  },
  "[bibtex]": {
    "editor.defaultFormatter": "James-Yu.latex-workshop",
  },
  "[properties]": {
    "editor.defaultFormatter": "foxundermoon.shell-format",
  },
  "[handlebars]": {
    "editor.defaultFormatter": "vscode.html-language-features",
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[mdx]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[dockercompose]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[dockerfile]": {
    "editor.defaultFormatter": "ms-azuretools.vscode-docker",
  },
  // VSCode stuff
  "breadcrumbs.enabled": true,
  "explorer.compactFolders": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.confirmDelete": false,
  "diffEditor.ignoreTrimWhitespace": false,
  "extensions.supportUntrustedWorkspaces": {},
  "security.workspace.trust.untrustedFiles": "open",
  "files.watcherExclude": {
    "**/vendor/**": true,
    "**/node_modules/**": true,
  },
  // Emmet
  "emmet.syntaxProfiles": {
    "javascript": "jsx",
  },
  "emmet.includeLanguages": {
    "javascript": "javascriptreact",
  },
  // Extensions
  // Excalidraw
  "excalidraw.image": {
    "exportScale": 1,
    "exportWithBackground": true,
    "exportWithDarkMode": true,
  },
  "excalidraw.theme": "dark",
  // Git
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "git.ignoreRebaseWarning": true,
  "git.openRepositoryInParentFolders": "never",
  // Javascript
  "javascript.updateImportsOnFileMove.enabled": "always",
  "javascript.format.enable": false,
  // Typescript
  "typescript.preferences.includePackageJsonAutoImports": "on",
  "typescript.updateImportsOnFileMove.enabled": "always",
  "typescript.preferences.preferTypeOnlyAutoImports": true,
  // GitHubPullRequests
  "githubPullRequests.fileListLayout": "tree",
  "githubPullRequests.createOnPublishBranch": "never",
  "githubPullRequests.pullBranch": "never",
  "githubPullRequests.queries": [
    {
      "label": "Local Pull Request Branches",
      "query": "default",
    },
    {
      "label": "Local Pull Request Branches",
      "query": "repo:${owner}/${repository} default",
    },
    {
      "label": "Waiting For My Review",
      "query": "repo:${owner}/${repository} is:open review-requested:${user}",
    },
    {
      "label": "Assigned To Me",
      "query": "repo:${owner}/${repository} is:open assignee:${user}",
    },
    {
      "label": "Created By Me",
      "query": "repo:${owner}/${repository} is:open author:${user}",
    },
    {
      "label": "All Open",
      "query": "repo:${owner}/${repository} default",
    },
    {
      "label": "All Open",
      "query": "default",
    },
  ],
  // Debug
  "debug.onTaskErrors": "showErrors",
  // Files Icons
  "files.associations": {
    ".sequelizerc": "javascript",
    ".stylelintrc": "json",
    ".prettierrc": "json",
    "*.tsx": "typescriptreact",
  },
  "material-icon-theme.activeIconPack": "nest",
